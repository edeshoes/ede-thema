      "name": "bosluk olan hero",
      "settings": {
        "custom_liquid": "<div class=\"ede-hero\" id=\"edeHero\">\n\n  <!-- ==================== SLIDE 1 ==================== -->\n  <div class=\"ede-hero__slide is-active\">\n    <picture>\n      <source media=\"(max-width: 768px)\" srcset=\"{{ 'ede-hero-1-mobile.jpg' | file_url }}\">\n      <img src=\"{{ 'ede-hero-1-desktop.jpg' | file_url }}\" alt=\"Handmade barefoot shoes\" loading=\"eager\" fetchpriority=\"high\">\n    </picture>\n    <div class=\"ede-hero__scrim\"></div>\n    <div class=\"ede-hero__content\">\n      <h1>Handmade Barefoot Shoes for Grounded Living</h1>\n      <p>Soft leather. Natural movement. A more connected way to walk — handcrafted in small batches.</p>\n      <p class=\"ede-hero__note\"><em>Made by hand in Gaziantep, Türkiye.</em></p>\n      <div class=\"ede-hero__buttons\">\n        <a class=\"ede-btn ede-btn--solid\" href=\"/collections/women\">Shop Women</a>\n        <a class=\"ede-btn ede-btn--outline\" href=\"/collections/men\">Shop Men</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- ==================== SLIDE 2 ==================== -->\n  <div class=\"ede-hero__slide\">\n    <picture>\n      <source media=\"(max-width: 768px)\" srcset=\"{{ 'ede-hero-2-mobile.jpg' | file_url }}\">\n      <img src=\"{{ 'ede-hero-2-desktop.jpg' | file_url }}\" alt=\"Our atelier in Gaziantep\" loading=\"lazy\">\n    </picture>\n    <div class=\"ede-hero__scrim\"></div>\n    <div class=\"ede-hero__content\">\n      <h2>Three Generations. One Workshop.</h2>\n      <p>Every pair is cut, stitched and finished by hand — the same way since 1950.</p>\n      <div class=\"ede-hero__buttons\">\n        <a class=\"ede-btn ede-btn--solid\" href=\"/pages/process\">Our Process</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- ==================== SLIDE 3 ==================== -->\n  <div class=\"ede-hero__slide\">\n    <picture>\n      <source media=\"(max-width: 768px)\" srcset=\"{{ 'ede-hero-3-mobile.jpg' | file_url }}\">\n      <img src=\"{{ 'ede-hero-3-desktop.jpg' | file_url }}\" alt=\"Feel the ground beneath you\" loading=\"lazy\">\n    </picture>\n    <div class=\"ede-hero__scrim\"></div>\n    <div class=\"ede-hero__content\">\n      <h2>Feel the Ground Again</h2>\n      <p>Zero drop, wide toe box, leather sole with a copper touchpoint — stay connected to the earth.</p>\n      <div class=\"ede-hero__buttons\">\n        <a class=\"ede-btn ede-btn--solid\" href=\"/collections/womens-earthing-chukka-boots\">Explore Earthing</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- Bullet navigasyon -->\n  <div class=\"ede-hero__bullets\" role=\"tablist\" aria-label=\"Hero slides\">\n    <button class=\"is-active\" aria-label=\"Slide 1\"></button>\n    <button aria-label=\"Slide 2\"></button>\n    <button aria-label=\"Slide 3\"></button>\n  </div>\n</div>\n\n<style>\n  .ede-hero {\n    position: relative;\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    aspect-ratio: 2 / 1;           /* edeshoes 2:1 kuralı */\n    max-height: 88vh;\n    overflow: hidden;\n    background: #EDE5DA;\n  }\n  @media (max-width: 768px) {\n    .ede-hero { aspect-ratio: 4 / 5; max-height: none; }  /* dikey mobil */\n  }\n\n  .ede-hero__slide {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    transition: opacity .8s ease;\n    pointer-events: none;\n  }\n  .ede-hero__slide.is-active {\n    opacity: 1;\n    pointer-events: auto;\n  }\n  .ede-hero__slide picture,\n  .ede-hero__slide img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  /* Okunurluk için yumuşak scrim */\n  .ede-hero__scrim {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, rgba(0,0,0,.28) 0%, rgba(0,0,0,.08) 45%, rgba(0,0,0,0) 70%);\n  }\n  @media (max-width: 768px) {\n    .ede-hero__scrim {\n      background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.35) 100%);\n    }\n  }\n\n  .ede-hero__content {\n    position: absolute;\n    left: 6vw;\n    top: 50%;\n    transform: translateY(-50%);\n    max-width: 560px;\n    color: #FFFFFF;\n    z-index: 2;\n  }\n  @media (max-width: 768px) {\n    .ede-hero__content {\n      left: 6vw; right: 6vw;\n      top: auto; bottom: 8vh;\n      transform: none;\n      max-width: none;\n    }\n  }\n\n  .ede-hero__content h1,\n  .ede-hero__content h2 {\n    font-size: clamp(30px, 4.2vw, 58px);\n    line-height: 1.08;\n    margin: 0 0 18px;\n    font-weight: 500;\n  }\n  .ede-hero__content p {\n    font-size: clamp(15px, 1.2vw, 18px);\n    line-height: 1.5;\n    margin: 0 0 10px;\n  }\n  .ede-hero__note { opacity: .92; }\n\n  .ede-hero__buttons {\n    display: flex;\n    gap: 14px;\n    margin-top: 22px;\n    flex-wrap: wrap;\n  }\n  .ede-btn {\n    display: inline-block;\n    padding: 14px 30px;\n    font-size: 15px;\n    text-decoration: none;\n    letter-spacing: .02em;\n    transition: opacity .25s ease, background-color .25s ease;\n  }\n  .ede-btn--solid {\n    background: #7A5843;\n    color: #fff;\n  }\n  .ede-btn--solid:hover { opacity: .9; }\n  .ede-btn--outline {\n    border: 1px solid rgba(255,255,255,.85);\n    color: #fff;\n  }\n  .ede-btn--outline:hover { background: rgba(255,255,255,.12); }\n\n  /* Raum tarzı bullet'lar — sağ alt */\n  .ede-hero__bullets {\n    position: absolute;\n    right: 28px;\n    bottom: 22px;\n    display: flex;\n    gap: 10px;\n    z-index: 3;\n  }\n  .ede-hero__bullets button {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,.9);\n    background: transparent;\n    padding: 0;\n    cursor: pointer;\n    transition: background-color .3s ease, transform .3s ease;\n  }\n  .ede-hero__bullets button.is-active {\n    background: #fff;\n    transform: scale(1.15);\n  }\n</style>\n\n<script>\n  (function () {\n    var INTERVAL = 7000;   /* 7 saniye — edeshoes kuralı */\n\n    var root = document.getElementById('edeHero');\n    if (!root) return;\n    var slides = root.querySelectorAll('.ede-hero__slide');\n    var bullets = root.querySelectorAll('.ede-hero__bullets button');\n    var index = 0, timer = null;\n\n    function show(i) {\n      slides[index].classList.remove('is-active');\n      bullets[index].classList.remove('is-active');\n      index = i % slides.length;\n      slides[index].classList.add('is-active');\n      bullets[index].classList.add('is-active');\n    }\n    function next() { show(index + 1); }\n    function restart() {\n      clearInterval(timer);\n      timer = setInterval(next, INTERVAL);\n    }\n\n    bullets.forEach(function (b, i) {\n      b.addEventListener('click', function () { show(i); restart(); });\n    });\n\n    restart();\n  })();\n</script>",
