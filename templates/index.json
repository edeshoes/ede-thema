    "custom_liquid_XtyzBq": {
      "type": "custom-liquid",
      "name": "model grid",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     EDEBAREFOOT MODEL KART GRID v4 (NİHAİ)\n     Düzeltmeler:\n     · Karolar VARSAYILAN GÖRÜNÜR — belirme animasyonu ancak script\n       çalışırsa devreye girer (tema editörü yeniden çizimlerinde\n       görünmez kalma sorunu çözüldü)\n     · shopify:section:load dinleyicisi — editörde her yeniden\n       çizimde kendini yeniden başlatır\n     · Etiket konumu %12 (ayakkabıya yakın) · Tıklama garantisi dahil\n\n     KURULUM: \"model grid\" bölümündeki eski kodu tamamen sil,\n     bu dosyanın TAMAMINI yapıştır, Save.\n     ============================================================ -->\n\n{% assign WOMEN_CARDS = \"womens-barefoot-loafers:Loafers,womens-barefoot-boat-shoes:Boat Shoes,barefoot-ballet-flats:Ballet Flats,womens-barefoot-flats:Flats,womens-barefoot-oxfords:Oxfords,womens-chelsea-boots:Chelsea Boots,womens-barefoot-moccasins:Moccasins,womens-barefoot-boots:Boots\" | split: \",\" %}\n{% assign MEN_CARDS = \"mens-barefoot-loafers:Loafers,mens-barefoot-boat-shoes:Boat Shoes,mens-barefoot-oxfords:Oxfords,mens-chelsea-boots:Chelsea Boots\" | split: \",\" %}\n\n<div class=\"ede-vitrine\" id=\"edeVitrine\">\n\n  <div class=\"ede-vitrine__group\">\n    <h2 class=\"ede-vitrine__title\">Women</h2>\n    <div class=\"ede-vitrine__grid\">\n      {% for item in WOMEN_CARDS %}\n        {% assign parts = item | split: \":\" %}\n        {% assign c = collections[parts[0]] %}\n        {% assign img1 = c.image %}\n        {% if img1 == blank %}{% assign img1 = c.products.first.featured_image %}{% endif %}\n        {% assign img2 = c.products[1].featured_image %}\n        {% if img2 == blank %}{% assign img2 = c.products.first.images[1] %}{% endif %}\n        <a class=\"ede-tile\" href=\"/collections/{{ parts[0] }}\" style=\"--d: {{ forloop.index0 | modulo: 4 | times: 80 }}ms\">\n          {% if img1 %}<img class=\"ede-tile__img1\" src=\"{{ img1 | image_url: width: 1000 }}\" alt=\"{{ parts[1] }}\" loading=\"lazy\">{% endif %}\n          {% if img2 %}<img class=\"ede-tile__img2\" src=\"{{ img2 | image_url: width: 1000 }}\" alt=\"\" loading=\"lazy\" aria-hidden=\"true\">{% endif %}\n          <span class=\"ede-tile__meta\">\n            <span class=\"ede-tile__label\">{{ parts[1] }}</span>\n            <span class=\"ede-tile__price\">{{ c.products.first.price | money }}</span>\n          </span>\n        </a>\n      {% endfor %}\n    </div>\n    <div class=\"ede-vitrine__more\"><a href=\"/collections/women\">View all women</a></div>\n  </div>\n\n  <div class=\"ede-vitrine__group\">\n    <h2 class=\"ede-vitrine__title\">Men</h2>\n    <div class=\"ede-vitrine__grid\">\n      {% for item in MEN_CARDS %}\n        {% assign parts = item | split: \":\" %}\n        {% assign c = collections[parts[0]] %}\n        {% assign img1 = c.image %}\n        {% if img1 == blank %}{% assign img1 = c.products.first.featured_image %}{% endif %}\n        {% assign img2 = c.products[1].featured_image %}\n        {% if img2 == blank %}{% assign img2 = c.products.first.images[1] %}{% endif %}\n        <a class=\"ede-tile\" href=\"/collections/{{ parts[0] }}\" style=\"--d: {{ forloop.index0 | modulo: 4 | times: 80 }}ms\">\n          {% if img1 %}<img class=\"ede-tile__img1\" src=\"{{ img1 | image_url: width: 1000 }}\" alt=\"{{ parts[1] }}\" loading=\"lazy\">{% endif %}\n          {% if img2 %}<img class=\"ede-tile__img2\" src=\"{{ img2 | image_url: width: 1000 }}\" alt=\"\" loading=\"lazy\" aria-hidden=\"true\">{% endif %}\n          <span class=\"ede-tile__meta\">\n            <span class=\"ede-tile__label\">{{ parts[1] }}</span>\n            <span class=\"ede-tile__price\">{{ c.products.first.price | money }}</span>\n          </span>\n        </a>\n      {% endfor %}\n    </div>\n    <div class=\"ede-vitrine__more\"><a href=\"/collections/men\">View all men</a></div>\n  </div>\n\n</div>\n\n<style>\n  .ede-vitrine {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    padding: 56px 0 24px;\n  }\n  .ede-vitrine__group + .ede-vitrine__group { margin-top: 40px; }\n\n  .ede-vitrine__title {\n    text-align: center;\n    font-size: clamp(24px, 2.4vw, 32px);\n    font-weight: 500;\n    letter-spacing: .02em;\n    margin: 0 0 30px;\n  }\n\n  .ede-vitrine__grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 0;\n  }\n  @media (max-width: 900px) {\n    .ede-vitrine__grid { grid-template-columns: repeat(2, 1fr); }\n  }\n\n  /* VARSAYILAN: görünür. Animasyon başlangıç durumu ancak\n     script .is-js ekleyebilirse uygulanır. */\n  .ede-tile {\n    position: relative;\n    display: block;\n    aspect-ratio: 4 / 5;\n    overflow: hidden;\n    text-decoration: none;\n    color: #2B2420;\n    background: #F2EDE6;\n  }\n  .ede-vitrine.is-js .ede-tile {\n    opacity: 0;\n    transform: translateY(26px);\n    transition: opacity .7s ease var(--d, 0ms), transform .7s ease var(--d, 0ms);\n  }\n  .ede-vitrine.is-js .ede-tile.is-revealed {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .ede-tile img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .ede-tile__img2 { opacity: 0; transition: opacity .45s ease; }\n\n  .ede-tile__meta {\n    position: absolute;\n    left: 0; right: 0;\n    bottom: 12%;\n    text-align: center;\n    z-index: 2;\n    pointer-events: none;\n  }\n  .ede-tile__label {\n    display: block;\n    font-size: clamp(13px, 1.1vw, 16px);\n    letter-spacing: .03em;\n  }\n  .ede-tile__price {\n    display: block;\n    margin-top: 3px;\n    font-size: clamp(12px, 1vw, 14px);\n    color: #6B6258;\n    opacity: 0;\n    transition: opacity .45s ease;\n  }\n\n  @media (hover: hover) {\n    .ede-tile:hover .ede-tile__img2 { opacity: 1; }\n    .ede-tile:hover .ede-tile__price { opacity: .7; }\n  }\n  .ede-tile.is-inview .ede-tile__img2 { opacity: 1; }\n  .ede-tile.is-inview .ede-tile__price { opacity: .7; }\n\n  .ede-vitrine__more {\n    text-align: center;\n    margin-top: 26px;\n  }\n  .ede-vitrine__more a {\n    font-size: 14px;\n    color: #7A5843;\n    text-decoration: none;\n    border-bottom: 1px solid currentColor;\n    padding-bottom: 2px;\n  }\n</style>\n\n<script>\n  (function () {\n    function initEdeVitrine() {\n      var root = document.getElementById('edeVitrine');\n      if (!root || root.dataset.edeInit === '1') return;\n      root.dataset.edeInit = '1';\n\n      var tiles = Array.prototype.slice.call(root.querySelectorAll('.ede-tile'));\n\n      /* Tıklama garantisi */\n      tiles.forEach(function (t) {\n        t.addEventListener('click', function (ev) {\n          ev.preventDefault();\n          ev.stopPropagation();\n          window.location.assign(t.getAttribute('href'));\n        }, true);\n      });\n\n      /* Belirme animasyonu — script çalışıyorsa aktive et */\n      if ('IntersectionObserver' in window) {\n        root.classList.add('is-js');\n        var revealObs = new IntersectionObserver(function (entries) {\n          entries.forEach(function (e) {\n            if (e.isIntersecting) {\n              e.target.classList.add('is-revealed');\n              revealObs.unobserve(e.target);\n            }\n          });\n        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });\n        tiles.forEach(function (t) { revealObs.observe(t); });\n      }\n\n      /* Dokunmatik: orta bantta otomatik ikinci görsel + fiyat */\n      var isTouch = window.matchMedia('(hover: none)').matches;\n      if (isTouch && 'IntersectionObserver' in window) {\n        var inviewObs = new IntersectionObserver(function (entries) {\n          entries.forEach(function (e) {\n            e.target.classList.toggle('is-inview', e.isIntersecting);\n          });\n        }, { rootMargin: '-35% 0px -35% 0px' });\n        tiles.forEach(function (t) { inviewObs.observe(t); });\n      }\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initEdeVitrine);\n    } else {\n      initEdeVitrine();\n    }\n    /* Tema editörü bölümü yeniden çizdiğinde yeniden başlat */\n    document.addEventListener('shopify:section:load', function () {\n      var root = document.getElementById('edeVitrine');\n      if (root) root.dataset.edeInit = '';\n      initEdeVitrine();\n    });\n  })();\n</script>",
