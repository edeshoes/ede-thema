      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"ede-announce\" aria-live=\"polite\">\n  <span class=\"ede-announce__dot\" aria-hidden=\"true\"></span>\n  <span class=\"ede-announce__text\" id=\"edeAnnounceText\"></span>\n</div>\n\n<style>\n  @font-face {\n    font-family: 'TRT';\n    src: url('{{ \"TRT-LIGHT.TTF\" | file_url }}') format('truetype');\n    font-weight: 300;\n    font-style: normal;\n    font-display: swap;\n  }\n\n  .ede-announce {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    height: 36px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    background: #2B2420;\n    color: #F5F1EA;\n    font-family: 'TRT', sans-serif;\n    font-weight: 300;\n    font-size: 12px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    overflow: hidden;\n    position: relative;\n    z-index: 5;\n  }\n\n  .ede-announce__dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #C8A96A;\n    position: relative;\n    flex: 0 0 auto;\n  }\n  .ede-announce__dot::after {\n    content: \"\";\n    position: absolute;\n    inset: -4px;\n    border-radius: 50%;\n    border: 1px solid #C8A96A;\n    animation: edeWave 2s ease-out infinite;\n  }\n  @keyframes edeWave {\n    0%   { transform: scale(0.6); opacity: 0.9; }\n    70%  { transform: scale(1.8); opacity: 0; }\n    100% { transform: scale(1.8); opacity: 0; }\n  }\n\n  .ede-announce__text {\n    white-space: nowrap;\n    overflow: hidden;\n    text-align: left;\n  }\n\n  @media (max-width: 600px) {\n    .ede-announce { font-size: 10px; letter-spacing: 0.05em; }\n  }\n</style>\n\n<script>\n  (function () {\n    /* ==== MESAJLAR — burayı düzenle ==== */\n    var MESSAGES = [\n      \"HANDMADE IN GAZIANTEP, TÜRKİYE\",\n      \"FREE DDP SHIPPING TO THE US\",\n      \"NO CUSTOMS FEES — EVER\",\n      \"MADE TO ORDER IN 5 DAYS\"\n    ];\n    var TYPE_SPEED = 55;\n    var DELETE_SPEED = 30;\n    var HOLD_AFTER_TYPE = 2200;\n    var HOLD_AFTER_DELETE = 400;\n\n    function start() {\n      var el = document.getElementById('edeAnnounceText');\n      if (!el) return;\n\n      function setFixedWidth() {\n        var style = window.getComputedStyle(el);\n        var canvas = setFixedWidth._c || (setFixedWidth._c = document.createElement('canvas'));\n        var ctx = canvas.getContext('2d');\n        ctx.font = style.fontWeight + ' ' + style.fontSize + ' ' + style.fontFamily;\n        var ls = parseFloat(style.letterSpacing) || 0;\n        var max = 0;\n        for (var i = 0; i < MESSAGES.length; i++) {\n          var w = ctx.measureText(MESSAGES[i].toUpperCase()).width\n                  + ls * MESSAGES[i].length;\n          if (w > max) max = w;\n        }\n        el.style.width = Math.ceil(max) + 'px';\n      }\n\n      setFixedWidth();\n      if (document.fonts && document.fonts.ready) {\n        document.fonts.ready.then(setFixedWidth);\n      }\n      var rt;\n      window.addEventListener('resize', function () {\n        clearTimeout(rt);\n        rt = setTimeout(setFixedWidth, 150);\n      });\n\n      var msgIndex = 0, charIndex = 0, deleting = false;\n\n      function tick() {\n        var current = MESSAGES[msgIndex];\n        if (!deleting) {\n          charIndex++;\n          el.textContent = current.slice(0, charIndex);\n          if (charIndex === current.length) {\n            deleting = true;\n            setTimeout(tick, HOLD_AFTER_TYPE);\n            return;\n          }\n          setTimeout(tick, TYPE_SPEED);\n        } else {\n          charIndex--;\n          el.textContent = current.slice(0, charIndex);\n          if (charIndex === 0) {\n            deleting = false;\n            msgIndex = (msgIndex + 1) % MESSAGES.length;\n            setTimeout(tick, HOLD_AFTER_DELETE);\n            return;\n          }\n          setTimeout(tick, DELETE_SPEED);\n        }\n      }\n      tick();\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', start);\n    } else {\n      start();\n    }\n  })();\n</script>",
