PE = 2200;\n    var HOLD_AFTER_DELETE = 400;\n\n    function start() {\n      var el = document.getElementById('edeAnnounceText');\n      if (!el) return;\n\n      function setFixedWidth() {\n        var style = window.getComputedStyle(el);\n        var canvas = setFixedWidth._c || (setFixedWidth._c = document.createElement('canvas'));\n        var ctx = canvas.getContext('2d');\n        ctx.font = style.fontWeight + ' ' + style.fontSize + ' ' + style.fontFamily;\n        var ls = parseFloat(style.letterSpacing) || 0;\n        var max = 0;\n        for (var i = 0; i < MESSAGES.length; i++) {\n          var w = ctx.measureText(MESSAGES[i].toUpperCase()).width\n                  + ls * MESSAGES[i].length;\n          if (w > max) max = w;\n        }\n        el.style.width = Math.ceil(max) + 'px';\n      }\n\n      setFixedWidth();\n      if (document.fonts && document.fonts.ready) {\n        document.fonts.ready.then(setFixedWidth);\n      }\n      var rt;\n      window.addEventListener('resize', function () {\n        clearTimeout(rt);\n        rt = setTimeout(setFixedWidth, 150);\n      });\n\n      var msgIndex = 0, charIndex = 0, deleting = false;\n\n      function tick() {\n        var current = MESSAGES[msgIndex];\n        if (!deleting) {\n          charIndex++;\n          el.textContent = current.slice(0, charIndex);\n          if (charIndex === current.length) {\n            deleting = true;\n            setTimeout(tick, HOLD_AFTER_TYPE);\n            return;\n          }\n          setTimeout(tick, TYPE_SPEED);\n        } else {\n          charIndex--;\n          el.textContent = current.slice(0, charIndex);\n          if (charIndex === 0) {\n            deleting = false;\n            msgIndex = (msgIndex + 1) % MESSAGES.length;\n            setTimeout(tick, HOLD_AFTER_DELETE);\n            return;\n          }\n          setTimeout(tick, DELETE_SPEED);\n        }\n      }\n      tick();\n    }\n\n    if (document.readyState === 'loading') {\n      document.