    "custom_liquid_UtJNmg": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     EDEBAREFOOT MODEL KART GRID v2 — Raum davranış seti\n     · Desktop 4 kolon / Mobil 2 kolon\n     · Desktop: hover'da ikinci görsel + silik fiyat (aynı anda)\n     · Mobil: kart ekranın orta bandına gelince ikinci görsel + fiyat otomatik\n     · Scroll'da kartlar sırayla belirir (fade + yukarı kayma)\n     · Kart tıklaması koleksiyon sayfasına gider\n     · Etiket ve fiyat görselin altında ORTALANMIŞ (Raum düzeni)\n\n     Görseller otomatik: 1. görsel = koleksiyon görseli (yoksa ilk ürün),\n     2. görsel = koleksiyonun ikinci ürününün görseli (yoksa ilk ürünün\n     ikinci fotoğrafı). Fiyat = koleksiyonun ilk ürününün fiyatı.\n\n     KURULUM: Custom Liquid bölümündeki eski grid kodunu tamamen sil,\n     bu dosyanın TAMAMINI yapıştır, Save.\n     Kart listesi: aşağıdaki WOMEN_CARDS / MEN_CARDS satırları.\n     ============================================================ -->\n\n{% assign WOMEN_CARDS = \"womens-barefoot-loafers:Loafers,womens-barefoot-boat-shoes:Boat Shoes,barefoot-ballet-flats:Ballet Flats,womens-barefoot-flats:Flats,womens-barefoot-oxfords:Oxfords,womens-chelsea-boots:Chelsea Boots,womens-barefoot-moccasins:Moccasins,womens-barefoot-boots:Boots\" | split: \",\" %}\n{% assign MEN_CARDS = \"mens-barefoot-loafers:Loafers,mens-barefoot-boat-shoes:Boat Shoes,mens-barefoot-oxfords:Oxfords,mens-chelsea-boots:Chelsea Boots\" | split: \",\" %}\n\n<div class=\"ede-grid\" id=\"edeGrid\">\n\n  <div class=\"ede-grid__group\">\n    <div class=\"ede-grid__head\">\n      <h2>Women</h2>\n      <a href=\"/collections/women\" class=\"ede-grid__all\">View all</a>\n    </div>\n    <div class=\"ede-grid__cards\">\n      {% for item in WOMEN_CARDS %}\n        {% assign parts = item | split: \":\" %}\n        {% assign c = collections[parts[0]] %}\n        {% assign img1 = c.image %}\n        {% if img1 == blank %}{% assign img1 = c.products.first.featured_image %}{% endif %}\n        {% assign img2 = c.products[1].featured_image %}\n        {% if img2 == blank %}{% assign img2 = c.products.first.images[1] %}{% endif %}\n        <a class=\"ede-card\" href=\"/collections/{{ parts[0] }}\" style=\"--d: {{ forloop.index0 | times: 70 }}ms\">\n          <div class=\"ede-card__media\">\n            {% if img1 %}<img class=\"ede-card__img1\" src=\"{{ img1 | image_url: width: 800 }}\" alt=\"{{ parts[1] }}\" loading=\"lazy\">{% endif %}\n            {% if img2 %}<img class=\"ede-card__img2\" src=\"{{ img2 | image_url: width: 800 }}\" alt=\"\" loading=\"lazy\" aria-hidden=\"true\">{% endif %}\n          </div>\n          <span class=\"ede-card__label\">{{ parts[1] }}</span>\n          <span class=\"ede-card__price\">{{ c.products.first.price | money }}</span>\n        </a>\n      {% endfor %}\n    </div>\n  </div>\n\n  <div class=\"ede-grid__group\">\n    <div class=\"ede-grid__head\">\n      <h2>Men</h2>\n      <a href=\"/collections/men\" class=\"ede-grid__all\">View all</a>\n    </div>\n    <div class=\"ede-grid__cards\">\n      {% for item in MEN_CARDS %}\n        {% assign parts = item | split: \":\" %}\n        {% assign c = collections[parts[0]] %}\n        {% assign img1 = c.image %}\n        {% if img1 == blank %}{% assign img1 = c.products.first.featured_image %}{% endif %}\n        {% assign img2 = c.products[1].featured_image %}\n        {% if img2 == blank %}{% assign img2 = c.products.first.images[1] %}{% endif %}\n        <a class=\"ede-card\" href=\"/collections/{{ parts[0] }}\" style=\"--d: {{ forloop.index0 | times: 70 }}ms\">\n          <div class=\"ede-card__media\">\n            {% if img1 %}<img class=\"ede-card__img1\" src=\"{{ img1 | image_url: width: 800 }}\" alt=\"{{ parts[1] }}\" loading=\"lazy\">{% endif %}\n            {% if img2 %}<img class=\"ede-card__img2\" src=\"{{ img2 | image_url: width: 800 }}\" alt=\"\" loading=\"lazy\" aria-hidden=\"true\">{% endif %}\n          </div>\n          <span class=\"ede-card__label\">{{ parts[1] }}</span>\n          <span class=\"ede-card__price\">{{ c.products.first.price | money }}</span>\n        </a>\n      {% endfor %}\n    </div>\n  </div>\n\n</div>\n\n<style>\n  .ede-grid {\n    max-width: 1360px;\n    margin: 0 auto;\n    padding: 64px 24px;\n  }\n  .ede-grid__group + .ede-grid__group { margin-top: 80px; }\n\n  .ede-grid__head {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    margin-bottom: 28px;\n  }\n  .ede-grid__head h2 {\n    font-size: clamp(24px, 2.6vw, 34px);\n    font-weight: 500;\n    margin: 0;\n    letter-spacing: .01em;\n  }\n  .ede-grid__all {\n    font-size: 14px;\n    text-decoration: none;\n    color: #7A5843;\n    border-bottom: 1px solid currentColor;\n    padding-bottom: 2px;\n  }\n\n  /* 4 kolon desktop / 2 kolon mobil */\n  .ede-grid__cards {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px;\n  }\n  @media (max-width: 900px) {\n    .ede-grid__cards { grid-template-columns: repeat(2, 1fr); gap: 12px; }\n    .ede-grid { padding: 44px 14px; }\n    .ede-grid__group + .ede-grid__group { margin-top: 56px; }\n  }\n\n  /* Kart — scroll'da sırayla belirme */\n  .ede-card {\n    display: block;\n    text-decoration: none;\n    color: inherit;\n    text-align: center;              /* Raum düzeni: her şey ortalı */\n    opacity: 0;\n    transform: translateY(26px);\n    transition: opacity .7s ease var(--d, 0ms), transform .7s ease var(--d, 0ms);\n  }\n  .ede-card.is-revealed {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .ede-card__media {\n    position: relative;\n    aspect-ratio: 4 / 5;\n    overflow: hidden;\n    background: #EDE5DA;\n  }\n  .ede-card__media img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .ede-card__img2 {\n    opacity: 0;\n    transition: opacity .45s ease;\n  }\n\n  .ede-card__label {\n    display: block;\n    margin-top: 14px;\n    font-size: 15px;\n    letter-spacing: .03em;\n  }\n\n  /* Fiyat: her zaman yer kaplar, hover'da silik belirir */\n  .ede-card__price {\n    display: block;\n    margin-top: 4px;\n    font-size: 14px;\n    color: #6B6258;\n    opacity: 0;\n    transition: opacity .45s ease;   /* ikinci görselle AYNI anda */\n  }\n\n  /* Desktop hover: ikinci görsel + fiyat birlikte */\n  @media (hover: hover) {\n    .ede-card:hover .ede-card__img2 { opacity: 1; }\n    .ede-card:hover .ede-card__price { opacity: .65; }\n  }\n\n  /* Mobil / dokunmatik: karta .is-inview gelince aynı davranış */\n  .ede-card.is-inview .ede-card__img2 { opacity: 1; }\n  .ede-card.is-inview .ede-card__price { opacity: .65; }\n</style>\n\n<script>\n  (function () {\n    var root = document.getElementById('edeGrid');\n    if (!root) return;\n    var cards = Array.prototype.slice.call(root.querySelectorAll('.ede-card'));\n\n    /* 1) Scroll'da sırayla belirme (herkes için) */\n    if ('IntersectionObserver' in window) {\n      var revealObs = new IntersectionObserver(function (entries) {\n        entries.forEach(function (e) {\n          if (e.isIntersecting) {\n            e.target.classList.add('is-revealed');\n            revealObs.unobserve(e.target);\n          }\n        });\n      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.15 });\n      cards.forEach(function (c) { revealObs.observe(c); });\n    } else {\n      cards.forEach(function (c) { c.classList.add('is-revealed'); });\n    }\n\n    /* 2) Dokunmatik cihazda: kart ekranın orta bandına gelince\n          ikinci görsel + fiyat otomatik görünür, çıkınca geri döner */\n    var isTouch = window.matchMedia('(hover: none)').matches;\n    if (isTouch && 'IntersectionObserver' in window) {\n      var inviewObs = new IntersectionObserver(function (entries) {\n        entries.forEach(function (e) {\n          e.target.classList.toggle('is-inview', e.isIntersecting);\n        });\n      }, { rootMargin: '-35% 0px -35% 0px' });  /* ekranın orta %30'luk bandı */\n      cards.forEach(function (c) { inviewObs.observe(c); });\n    }\n  })();\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
