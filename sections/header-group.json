    "custom_liquid_rMVrdh": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     EDEBAREFOOT ANNOUNCEMENT BAR\n     Nabız noktası + dalga halkası + daktilo yazı efekti\n     Kullanım: Tema editörü > Header grubu > Add section > Custom Liquid\n     Bu kodun TAMAMINI Custom Liquid alanına yapıştır.\n     Mesajları değiştirmek için aşağıdaki MESSAGES listesini düzenle.\n     ============================================================ -->\n\n<div class=\"ede-announce\" aria-live=\"polite\">\n  <span class=\"ede-announce__dot\" aria-hidden=\"true\"></span>\n  <span class=\"ede-announce__text\" id=\"edeAnnounceText\"></span><span class=\"ede-announce__cursor\" aria-hidden=\"true\"></span>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');\n\n  .ede-announce {\n    /* Sabit yükseklik: CLS'i sıfırda tutar */\n    height: 36px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    background: #2B2420; /* Ede koyu kahve */\n    color: #F5F1EA;\n    font-family: 'Space Mono', monospace;\n    font-size: 12px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    overflow: hidden;\n    position: relative;\n    z-index: 5;\n  }\n\n  /* Nokta + dalga halkası */\n  .ede-announce__dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #C8A96A; /* sıcak altın vurgu */\n    position: relative;\n    flex: 0 0 auto;\n  }\n  .ede-announce__dot::after {\n    content: \"\";\n    position: absolute;\n    inset: -4px;\n    border-radius: 50%;\n    border: 1px solid #C8A96A;\n    animation: edeWave 2s ease-out infinite;\n  }\n  @keyframes edeWave {\n    0%   { transform: scale(0.6); opacity: 0.9; }\n    70%  { transform: scale(1.8); opacity: 0; }\n    100% { transform: scale(1.8); opacity: 0; }\n  }\n\n  /* Daktilo imleci */\n  .ede-announce__cursor {\n    width: 7px;\n    height: 14px;\n    background: #F5F1EA;\n    margin-left: 2px;\n    animation: edeBlink 0.9s steps(1) infinite;\n    flex: 0 0 auto;\n  }\n  @keyframes edeBlink { 50% { opacity: 0; } }\n\n  /* Metin taşmasın */\n  .ede-announce__text {\n    white-space: nowrap;\n    overflow: hidden;\n  }\n\n  /* Hareket azaltma tercihi olan kullanıcıya saygı */\n  @media (prefers-reduced-motion: reduce) {\n    .ede-announce__dot::after, .ede-announce__cursor { animation: none; }\n  }\n\n  @media (max-width: 600px) {\n    .ede-announce { font-size: 10px; letter-spacing: 0.05em; }\n  }\n</style>\n\n<script>\n  (function () {\n    /* ==== MESAJLAR — burayı düzenle ==== */\n    var MESSAGES = [\n      \"HANDMADE IN GAZIANTEP, TÜRKİYE\",\n      \"FREE DDP SHIPPING TO THE US\",\n      \"NO CUSTOMS FEES — EVER\",\n      \"MADE TO ORDER IN 5 DAYS\"\n    ];\n    /* Hızlar (ms) */\n    var TYPE_SPEED = 55;      /* harf yazma */\n    var DELETE_SPEED = 30;    /* harf silme */\n    var HOLD_AFTER_TYPE = 2200;   /* yazı tamamlanınca bekleme */\n    var HOLD_AFTER_DELETE = 400;  /* silindikten sonra bekleme */\n\n    var el = document.getElementById('edeAnnounceText');\n    if (!el) return;\n\n    /* Hareket azaltma tercihi: efekt yerine sabit ilk mesaj */\n    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      el.textContent = MESSAGES[0];\n      return;\n    }\n\n    var msgIndex = 0, charIndex = 0, deleting = false;\n\n    function tick() {\n      var current = MESSAGES[msgIndex];\n      if (!deleting) {\n        charIndex++;\n        el.textContent = current.slice(0, charIndex);\n        if (charIndex === current.length) {\n          deleting = true;\n          setTimeout(tick, HOLD_AFTER_TYPE);\n          return;\n        }\n        setTimeout(tick, TYPE_SPEED);\n      } else {\n        charIndex--;\n        el.textContent = current.slice(0, charIndex);\n        if (charIndex === 0) {\n          deleting = false;\n          msgIndex = (msgIndex + 1) % MESSAGES.length;\n          setTimeout(tick, HOLD_AFTER_DELETE);\n          return;\n        }\n        setTimeout(tick, DELETE_SPEED);\n      }\n    }\n    tick();\n  })();\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
